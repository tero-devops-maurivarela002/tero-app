# Variables de entorno para docker compose.
# Copiar a .env (cp .env.example .env) y completar los valores vacíos.
# El archivo .env está en .gitignore: NUNCA se sube al repositorio.
#
# Para generar valores seguros:
#   openssl rand -hex 24   (contraseñas)
#   openssl rand -hex 32   (ADMIN_JWT_SECRET)

# PostgreSQL: usuario y contraseña que comparten db, catalog, carts, orders y admin.
# Si cambiás el usuario, cambialo también en init-db.sql (los GRANT lo nombran).
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=

# Panel de administración
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
